{
  "name": "@dataplan/pg-bun",
  "version": "1.0.0",
  "description": "Bun SQL native adaptor for @dataplan/pg",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist",
    "pack": "npm pack",
    "pack-local": "npm pack --pack-destination .",
    "install-local": "npm install ./*.tgz",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:performance": "bun test tests/performance"
  },
  "peerDependencies": {
    "@dataplan/pg": "^1.0.0",
    "grafast": "^0.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "pg": "^8.11.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/dataplan-pg-bun.git"
  },
  "keywords": [
    "bun",
    "postgres",
    "postgresql",
    "sql",
    "dataplan",
    "graphile",
    "grafast",
    "database",
    "adapter"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/your-username/dataplan-pg-bun/issues"
  },
  "homepage": "https://github.com/your-username/dataplan-pg-bun#readme"
}